# Copy this file to .env.local and fill it in.

# PostgreSQL connection string. REQUIRED.
# Direct/unpooled connection strings (DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING)
# are preferred by scripts and schema migrations ahead of DATABASE_URL / POSTGRES_URL
# because transaction poolers (e.g. Neon -pooler) strip startup search_path and timeout settings.
# On Vercel with Neon/Postgres integrations, both sets of variables are usually populated.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/dbname?sslmode=require

# Signs the session cookie. REQUIRED in production (at least 32 characters).
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# Optional one-time token required to complete first-run /setup in production.
# Generate one with:  openssl rand -hex 24
# SETUP_TOKEN=

# Currency used for every valuation shown in the interface (ISO 4217 code).
# NEXT_PUBLIC_CURRENCY=USD

# Optional comma-separated origins permitted for Next.js dev HMR requests.
# ALLOWED_DEV_ORIGINS=192.168.1.50

# Calendar auto-sync & webhook secrets (generate with: openssl rand -hex 32).
# CALENDAR_SYNC_SECRET=
# CRON_SECRET=

# SharePoint calendar workbook URL used by `npm run seed` and calendar auto-sync.
# SHAREPOINT_CALENDAR_URL=

# Optional Microsoft Graph / SharePoint credentials for background calendar sync.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_GRAPH_ACCESS_TOKEN=
# SHAREPOINT_COOKIE=

# The same app registration also powers "Sign in with Microsoft" and the weekly
# reminder emails:
#  - Sign-in: add <APP_URL>/api/auth/microsoft/callback as a Web redirect URI.
#    Only people who already have an account here (matched by work email) can
#    sign in this way; Microsoft sign-in never creates accounts.
#  - Reminders: grant the Mail.Send application permission (admin consent) and
#    set MAIL_FROM to the mailbox they are sent from. Vercel Cron calls
#    /api/reminders/weekly every Monday with CRON_SECRET.
# MAIL_FROM=tt.office@iica.int
# Public address of the app, used for links in emails and the sign-in redirect.
# On Vercel it falls back to the production domain if left unset.
# APP_URL=https://your-app.vercel.app

# Optional staff initials -> full name overrides for CLI scripts (JSON object or path to JSON file).
# Example: STAFF_INITIALS_ALIASES='{"AB":"Alex Brown"}'
# STAFF_INITIALS_ALIASES=
# STAFF_INITIALS_FILE=

# Only read by `npm run seed` / `npm run db:setup` when creating the first administrator.
# ADMIN_NAME=IICA Administrator
# ADMIN_EMAIL=admin@iica.org
# ADMIN_PASSWORD=
# SEED_CREDENTIALS_FILE=./seed-credentials.txt
